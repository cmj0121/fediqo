# The release, as lanes. A tag is what makes one; everything else here is worked out rather
# than typed. What runs on a laptop and what runs on a runner is the same file, because
# everything it needs to know it reads out of the environment and scripts/env.sh is what put
# it there.

require "digest"
require "plist"
require "shellwords"

ROOT         = File.expand_path("..", __dir__)
XCODEPROJ    = File.join(ROOT, "Fediqo.xcodeproj")
MACOS_SCHEME = "Fediqo"
IOS_SCHEME   = "Fediqo-iOS"
DERIVED      = File.join(ROOT, ".build", "xcode-release")
OUTPUT       = File.join(ROOT, ".build", "release")

# fastlane reads .env itself, and an empty value there is not nothing. `MATCH_PASSWORD=` with
# nothing after it arrives in Ruby as "", which is truthy -- so match takes the empty string
# for the passphrase, never looks in the keychain where the real one is, and then blames the
# environment variable for the failure. Empty is unset, here as it is in scripts/env.sh.
%w[
  MATCH_PASSWORD
  MATCH_GIT_BASIC_AUTHORIZATION
  ASC_KEY_ID
  ASC_ISSUER_ID
  ASC_KEY_P8_BASE64
  FEDIQO_APPLE_ID
  FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD
].each { |name| ENV.delete(name) if ENV[name].to_s.empty? }

BUNDLE_ID = ENV.fetch("FEDIQO_BUNDLE_ID")
TEAM_ID   = ENV.fetch("FEDIQO_TEAM_ID")
APPLE_ID  = ENV["FEDIQO_APPLE_ID"]

# The installer identity, named by its kind rather than by whose name is on it. Xcode resolves
# the prefix against the keychain, so the same string works on any machine match has run on.
INSTALLER_IDENTITY = "3rd Party Mac Developer Installer"

# The App Store Connect key, where there is one. It is the only way in that never stops to ask
# a person for a second factor, which is the only kind a runner can use. Nil where it is not
# configured, and every action below then falls back to the Apple ID in the Appfile.
def asc_api_key
  return $asc_api_key if defined?($asc_api_key)

  key_id  = ENV["ASC_KEY_ID"].to_s
  issuer  = ENV["ASC_ISSUER_ID"].to_s
  content = ENV["ASC_KEY_P8_BASE64"].to_s

  $asc_api_key =
    if key_id.empty? || issuer.empty? || content.empty?
      UI.important("No App Store Connect key -- signing in as a person, who will be asked for a second factor.")
      nil
    else
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer,
        key_content: content,
        is_key_content_base64: true,
        in_house: false,
      )
    end
end

def version_sh(flag)
  `#{File.join(ROOT, "scripts", "version.sh")} #{flag} 2>/dev/null`.strip
end

# The tag names the release and the history counts the attempts. App Store Connect may already
# hold the number this history would produce again, though -- the same commit released twice
# counts the same commits twice -- so it is asked, and whichever is higher wins.
#
# One number for both platforms. A release attempt is one attempt however many stores it
# reaches, and a build 92 that means one thing on the phone and another on the Mac is a build
# number nobody can read back.
def build_number(version)
  from_history = version_sh("--build").to_i

  seen = ["ios", "osx"].map do |platform|
    begin
      latest_testflight_build_number(
        app_identifier: BUNDLE_ID,
        version: version,
        platform: platform,
        initial_build_number: 0,
        api_key: asc_api_key,
        username: APPLE_ID,
      ).to_i
    rescue StandardError => error
      UI.important("Nothing on App Store Connect for #{platform} #{version} yet (#{error.class}); counting it as none.")
      0
    end
  end

  [from_history, seen.max + 1].max
end

# What the archive is told on the command line rather than in the project: the version, the
# team, and which profile to sign with. The profile has to be here and not only in the export
# options -- Release signs manually, and a manual archive with no profile named fails before
# there is anything to export.
def stamp(version, build)
  "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build} DEVELOPMENT_TEAM=#{TEAM_ID}"
end

# Signing has to be written into the one target it belongs to. Handed to xcodebuild on the
# command line it reaches every target in the build -- including the resource bundles Swift
# Package Manager generates, which sign automatically, want no profile, and stop the build to
# say so. The project is generated and gitignored, so writing into it costs nothing: the next
# `make xcodeproj` has never heard of any of this.
def sign_target(target, profile, identity)
  update_code_signing_settings(
    path: XCODEPROJ,
    targets: [target],
    build_configurations: ["Release"],
    use_automatic_signing: false,
    team_id: TEAM_ID,
    code_sign_identity: identity,
    profile_name: profile,
  )
end

# match writes what it fetched into the environment under these keys, so nothing downstream has
# to be told a name or a path that stops being true the next time match runs. iOS carries no
# platform in the key, for reasons of fastlane's own history.
def match_env(platform, suffix)
  key = ["sigh", BUNDLE_ID, "appstore", (platform == :macos ? "macos" : nil), suffix].compact.join("_")
  ENV.fetch(key)
end

def profile_name(platform)
  match_env(platform, "profile-name")
end

# More than one certificate on a machine can answer to "Apple Distribution: … (J83AK3D9HB)" --
# a team is allowed several, and they accumulate. xcodebuild is given a name and picks one, and
# nothing says which; when it picks one the profile does not list, the archive fails to sign
# and the message talks about the profile, which is the one thing that was right.
#
# So ask the profile. It carries the certificates it will accept, and the answer that is also
# in this keychain is the one to sign with. A fingerprint names exactly one certificate, which
# is the whole of what was missing.
def identity_for(platform)
  profile = match_env(platform, "profile-path")
  plist = Plist.parse_xml(`security cms -D -i #{Shellwords.escape(profile)} 2>/dev/null`)

  accepted = Array(plist && plist["DeveloperCertificates"]).map do |der|
    Digest::SHA1.hexdigest(der.respond_to?(:string) ? der.string : der.to_s).upcase
  end
  installed = `security find-identity -v`.scan(/\b([0-9A-F]{40})\b/).flatten

  (accepted & installed).first || UI.user_error!(
    "None of the #{accepted.count} certificates in '#{File.basename(profile)}' is in this keychain. " \
    "Run match again, or check that the certificate has not expired."
  )
end

desc "Archive, sign and send both apps to TestFlight. Nothing is submitted for review."
lane :publish do
  # No tag is asked for here. A tag is what makes a release happen -- it is what the workflow
  # fires on -- but it is not what makes this command work. A laptop publishes whenever
  # somebody types this, and takes whatever version scripts/version.sh settled for, saying so
  # out loud when it had to settle. The tag is CI's business, and CI runs this same line.
  version = version_sh("--marketing")
  build   = build_number(version)
  UI.important("Fediqo #{version} (#{build}) -- both platforms, TestFlight only.")

  publish_ios(version: version, build: build)
  publish_macos(version: version, build: build)

  UI.success("Fediqo #{version} (#{build}) is on TestFlight. Nothing was submitted for review.")
end

desc "The iPhone and iPad build, as far as TestFlight."
private_lane :publish_ios do |options|
  match(type: "appstore", platform: "ios", api_key: asc_api_key, username: APPLE_ID)
  profile  = profile_name(:ios)
  identity = identity_for(:ios)
  sign_target(IOS_SCHEME, profile, identity)

  build_app(
    project: XCODEPROJ,
    scheme: IOS_SCHEME,
    configuration: "Release",
    export_method: "app-store",
    derived_data_path: DERIVED,
    output_directory: OUTPUT,
    output_name: "Fediqo-iOS",
    xcargs: stamp(options[:version], options[:build]),
    export_options: {
      teamID: TEAM_ID,
      signingCertificate: identity,
      provisioningProfiles: { BUNDLE_ID => profile },
    },
  )

  upload_to_testflight(
    api_key: asc_api_key,
    username: APPLE_ID,
    app_identifier: BUNDLE_ID,
    app_platform: "ios",
    # Where gym says it put it, rather than where the name suggests: gym appends the
    # extension itself, so a name that already has one comes back doubled.
    ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
    skip_submission: true,
    skip_waiting_for_build_processing: true,
  )
end

desc "The Mac build, as a package the installer identity signed, as far as TestFlight."
private_lane :publish_macos do |options|
  # Two fetches, not one. The app is signed with the distribution identity and the package
  # around it with the installer identity, and the Mac App Store takes only a package.
  match(type: "appstore", platform: "macos", api_key: asc_api_key, username: APPLE_ID)
  # Only the certificate is wanted here. Left to itself this call also invents a provisioning
  # profile, of no type anybody asked for, and pushes it into the shared repository.
  match(type: "mac_installer_distribution", platform: "macos", skip_provisioning_profiles: true,
        api_key: asc_api_key, username: APPLE_ID)
  profile  = profile_name(:macos)
  identity = identity_for(:macos)
  sign_target(MACOS_SCHEME, profile, identity)

  build_app(
    project: XCODEPROJ,
    scheme: MACOS_SCHEME,
    configuration: "Release",
    export_method: "app-store",
    installer_cert_name: INSTALLER_IDENTITY,
    derived_data_path: DERIVED,
    output_directory: OUTPUT,
    output_name: "Fediqo",
    xcargs: stamp(options[:version], options[:build]),
    export_options: {
      teamID: TEAM_ID,
      signingCertificate: identity,
      provisioningProfiles: { BUNDLE_ID => profile },
    },
  )

  upload_to_testflight(
    api_key: asc_api_key,
    username: APPLE_ID,
    app_identifier: BUNDLE_ID,
    app_platform: "osx",
    pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
    skip_submission: true,
    skip_waiting_for_build_processing: true,
  )
end

