{
	admin off
	auto_https disable_redirects
	local_certs
	skip_install_trust
	servers {
		protocols h1 h2
	}
}

# Fediqo fetches HTTPS only, and Host.parse has no port. *.localhost is 127.0.0.1
# on this OS, so 443 is the one port a join can actually use.
mastodon.localhost {
	tls internal
	reverse_proxy mastodon-web:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

discourse.localhost {
	tls internal
	reverse_proxy discourse:3000 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

discuz.localhost {
	tls internal
	reverse_proxy discuz:80 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

# Behind the `gotosocial` profile of compose.yml. Where that server is not up this name
# answers 502 and nothing else here is touched.
gotosocial.localhost {
	tls internal
	reverse_proxy gotosocial:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {host}
	}
}

# A page with Open Graph tags (`servers/card`), for a post to link to and gain a preview. Asked
# only by Mastodon's worker (the `worker` profile of compose.yml), from inside the compose
# network, where `card.example.com` is this container. Plain HTTP: the worker trusts no CA of
# this machine's, and the port is not published, so nothing outside the network reaches it.
http://card.example.com {
	root * /srv/card
	file_server
}
