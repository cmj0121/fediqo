# Dummy values for the local protocol servers. `make servers` copies this to
# `.env` and fills the empty secrets. Nothing here is used on a public net.

MASTODON_DB_PASSWORD=local-only
DISCOURSE_DB_PASSWORD=local-only
DISCUZ_DB_PASSWORD=local-only

# Mastodon 4.x asks for mixed case, a digit, and length. Discourse wants 15+.
MASTODON_WRITER_PASSWORD=LocalOnlyPass1
DISCOURSE_ADMIN_PASSWORD=local-only-pass1
DISCUZ_ADMIN_PASSWORD=LocalOnlyPass1

# Filled by `make servers` on first run. Do not invent them by hand.
SECRET_KEY_BASE=
OTP_SECRET=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
DISCOURSE_SECRET_KEY_BASE=
