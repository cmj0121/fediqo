    "network.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What has been asked of other people's servers, and how much of it came back."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "向別人的伺服器要過些什麼，以及其中有多少真的回來了。"
          }
