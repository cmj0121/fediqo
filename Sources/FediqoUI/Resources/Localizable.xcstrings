    "onboarding.server.source.builtIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The directory could not be reached, so this is the short list built into the app."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上目錄服務，這是內建在 app 裡的簡短清單。"
          }
