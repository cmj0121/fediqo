    "onboarding.protocol.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fediqo reads networks you already belong to. It adds no account, no handle, and no server of its own."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Fediqo 讀你已經在用的網路。它不會多給你一個帳號、一個代號，也沒有自己的伺服器。"
          }
        }
      }
    },
    "onboarding.protocol.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a protocol"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "選一種協定"
          }
        }
      }
    },
    "onboarding.server.add": {
      "extractionState": "manual",
      "localizations": {
