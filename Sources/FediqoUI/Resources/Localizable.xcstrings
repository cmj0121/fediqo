    "timeline.addSource.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server is a source, not a tab. Adding one changes what is in the timeline, never how it is ordered."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器是來源，不是分頁。新增它會改變時間軸裡有什麼，不會改變排序。"
          }
        }
      }
    },
