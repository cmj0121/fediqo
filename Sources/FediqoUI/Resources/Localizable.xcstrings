    "compose.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One composer, several networks."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "一個編輯器，數個網路。"
          }
        }
      }
    },
    "compose.soon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The composer lands with issue #8. It will publish to each account you chose, exactly once, and say where it went."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器會隨 issue #8 一起落地。它會把貼文送到你選的每個帳號各一次，並如實說明送到了哪裡。"
          }
        }
      }
    },
    "compose.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Post"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "發新文"
          }
        }
      }
    },
    "compose.wip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未實作"
          }
        }
      }
    },
    "error.badHost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not a hostname."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是一個主機名稱。"
          }
        }
      }
    },
    "error.http": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server answered %@."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器回應 %@。"
          }
        }
      }
    },
    "error.needsSignIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ does not hand over its public timeline without signing in, so it is contributing nothing."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不登入就不交出公開時間軸，所以它現在沒有貢獻任何內容。"
          }
        }
      }
    },
    "error.notThatKind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ did not answer as a %2$@ server."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的回應不像一個 %2$@ 伺服器。"
          }
        }
      }
    },
    "error.signInFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in failed: %@"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "登入失敗：%@"
          }
        }
      }
    },
    "error.tokenRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has stopped accepting that sign-in — sign in again, or sign out. The posts below are what it shows a stranger."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再接受這個登入，請重新登入或登出。下面的貼文是它給陌生人看的版本。"
          }
        }
      }
    },
    "error.unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not spoken yet, so this server is contributing nothing."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前還不會說 %@，所以這個伺服器沒有貢獻任何內容。"
          }
        }
      }
    },
    "kept.soon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you keep stops rotating out, and nothing about it is told to any server. It lands with issue #7."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "你保留的東西不會被輪替掉，而且不會告訴任何伺服器你保留了什麼。這會隨 issue #7 一起落地。"
          }
        }
      }
    },
    "kept.title": {
      "extractionState": "manual",
      "localizations": {
