    "settings.reset.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs out everywhere, forgets every server, empties the store and puts every setting back. Nothing is kept, and it cannot be undone."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "會登出所有帳號、忘掉每一台伺服器、清空本機資料，並把所有設定復原。什麼都不留，而且無法復原。"
          }
        }
      }
    },
    "settings.reset.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這個動作無法復原。"
          }
        }
      }
    },
