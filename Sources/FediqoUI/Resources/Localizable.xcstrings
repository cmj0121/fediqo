    "settings.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no Fediqo server. Everything on these screens happens on this device, and the only request that goes somewhere you did not choose is the suggested-server list, asked for on the server picker."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Fediqo 沒有伺服器。這些畫面上的一切都在這台裝置上發生；唯一送往你沒選過的地方的請求，是伺服器挑選頁上的建議清單。"
          }
        }
      }
    },
    "settings.sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sentence at the size you chose, so the choice can be seen before it is kept."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "用你選的大小寫一句話，讓這個選擇在留下之前先被看見。"
          }
        }
      }
    },
