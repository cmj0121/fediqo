    "onboarding.server.source.builtIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The directory could not be reached, so this is the short list built into the app."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "連不上目錄服務，這是內建在 app 裡的簡短清單。"
          }
        }
      }
    },
    "onboarding.server.source.joinMastodon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions come from api.joinmastodon.org. It is the only request Fediqo makes to somewhere you did not choose, and it is made only on this screen."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "建議清單來自 api.joinmastodon.org。這是 Fediqo 唯一一個送往你沒選過的地方的請求，而且只在這一頁發生。"
          }
        }
      }
    },
    "onboarding.server.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not signing in. Fediqo reads what the server hands over to anyone, and writes nothing to it."
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這不是登入。Fediqo 只讀伺服器願意給任何人的內容，不會寫入任何東西。"
          }
        }
      }
    },
    "onboarding.server.suggested": {
      "extractionState": "manual",
